{
  "compilerOptions": {
    "lib": ["ES2022"],
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "lib",
    "strict": true,
    "target": "ES2022",
    "typeRoots" : ["./node_modules/@types", "./src/types"],
    "noImplicitAny": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@ecency/sdk/hive": ["./node_modules/@ecency/sdk/dist/browser/hive.d.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/types/*.ts.d"
  ]
}
